# Stats web: static files and API proxy on the internal network. The edge terminates TLS.
{
	auto_https off
	servers {
		trusted_proxies static 172.30.50.0/24
	}
}

http://:8080 {
	encode zstd gzip
	root * /srv/stats
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Cache-Control "no-cache"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'; upgrade-insecure-requests"
		-Server
	}

	route {
		@api path /api/* /meta /health /live /ready /telemetry /feedback
		handle @api {
			reverse_proxy stats-api:8000 {
				header_up X-Forwarded-For {client_ip}
				header_up X-Real-IP {client_ip}
			}
		}

		@homeEdge path /home-edge
		redir @homeEdge /home-court-advantage/ 301

		@player path /player/*
		handle @player {
			rewrite * /player/index.html
			file_server
		}

		@assets path /assets/*
		handle @assets {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		handle {
			try_files {path} {path}/ /index.html
			file_server
		}
	}
}
